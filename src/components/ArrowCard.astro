---
import type { CollectionEntry } from "astro:content";
import SafeImage from "./SafeImage.astro";

interface Props {
  entry: CollectionEntry<"articles"> | CollectionEntry<"coffee"> | CollectionEntry<"photos">;
  showImage?: boolean;
}

const { entry, showImage = false } = Astro.props;

let imageSource;
let imageAlt: string = "";
let isImageHidden = false;

if (entry.collection === "articles") {
  imageSource = entry.data.coverImage;
  imageAlt = entry.data.coverAlt ?? entry.data.title ?? "";
  isImageHidden = entry.data.hideImage ?? false;
} else if (entry.collection === "photos") {
  imageSource = entry.data.thumbnail;
  imageAlt = entry.data.title ?? "";
} else if (entry.collection === "coffee") {
  imageAlt = entry.data.name ?? "";
}

const shouldRenderImage = showImage && !isImageHidden && Boolean(imageSource);

const title = entry.collection === "coffee" ? entry.data.name : entry.data.title;
const description = entry.collection === "coffee" 
  ? `${entry.data.roaster} • ${entry.data.origin}` 
  : entry.data.description;
---

<a href={`/${entry.collection}/${entry.slug}`} class="group flex flex-row items-center p-3 gap-4 overflow-hidden rounded-2xl border border-black/5 dark:border-white/5 bg-neutral-100/50 dark:bg-neutral-900/50 transition-all duration-300 hover:bg-white dark:hover:bg-neutral-800 shadow-sm transition-shadow">
  
  {shouldRenderImage && (
    <div class="relative w-16 h-16 sm:w-20 sm:h-20 shrink-0 overflow-hidden rounded-xl border border-black/10 dark:border-white/10 bg-neutral-200 dark:bg-neutral-800">
      <SafeImage 
        imageMetadata={imageSource} 
        alt={imageAlt} 
        className="w-full h-full object-cover grayscale opacity-80 group-hover:grayscale-0 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500" 
      />
    </div>
  )}

  <div class="flex flex-col justify-center grow min-w-0 gap-1">
    <div class="flex items-start justify-between gap-4">
      <h3 class="font-semibold text-black dark:text-white leading-tight line-clamp-2">
        {title}
      </h3>
      <div class="pt-1 shrink-0 opacity-20 group-hover:opacity-100 transition-all group-hover:translate-x-1">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="size-4">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </div>
    </div>
    
    {description && (
      <p class="text-xs text-neutral-500 dark:text-neutral-400 line-clamp-2 leading-relaxed">
        {description}
      </p>
    )}
  </div>
</a>