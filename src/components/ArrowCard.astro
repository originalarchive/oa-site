---
import type { CollectionEntry } from "astro:content";
import SafeImage from "./SafeImage.astro";

interface Props {
  entry: CollectionEntry<"articles"> | CollectionEntry<"coffee"> | CollectionEntry<"photos">;
}

const { entry } = Astro.props;

let imageSource;
if (entry.collection === "articles") {
  imageSource = entry.data.coverImage;
} else if (entry.collection === "photos") {
  imageSource = entry.data.thumbnail;
}

const title = entry.collection === "coffee" ? entry.data.name : entry.data.title;
const description = entry.collection === "coffee" 
  ? `${entry.data.roaster} • ${entry.data.origin}` 
  : entry.data.description;
---

<a href={`/${entry.collection}/${entry.slug}`} class="group flex flex-row items-stretch overflow-hidden rounded-xl border border-black/5 dark:border-white/5 bg-neutral-100/50 dark:bg-neutral-900/50 transition-all duration-300 hover:bg-neutral-200/50 dark:hover:bg-neutral-800/50">
  
  {/* IMAGE COLUMN (112px) */}
  {imageSource && (
    <div class="relative w-28 shrink-0 border-r border-black/5 dark:border-white/5 bg-neutral-200/50 dark:bg-neutral-800/50">
      <SafeImage 
        imageMetadata={imageSource} 
        alt={title} 
        className="absolute inset-0 grayscale group-hover:grayscale-0 transition-all duration-500 group-hover:scale-105" 
      />
    </div>
  )}

  {/* CONTENT COLUMN */}
  <div class="flex flex-col justify-center p-4 grow min-w-0 gap-1">
    <div class="flex items-start justify-between gap-4">
      <h3 class="font-semibold text-black dark:text-white leading-tight line-clamp-2">
        {title}
      </h3>
      <div class="pt-1 shrink-0 opacity-20 group-hover:opacity-100 transition-all group-hover:translate-x-1">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="size-4">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </div>
    </div>
    
    {description && (
      <p class="text-xs text-neutral-500 dark:text-neutral-400 line-clamp-2">
        {description}
      </p>
    )}
  </div>
</a>