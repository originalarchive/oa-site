---
import { Image } from "astro:assets";

interface Props {
  imageMetadata?: any;
  alt: string;
  className?: string;
}

const { imageMetadata, alt, className } = Astro.props;

const isLocal = typeof imageMetadata === 'object';
const isExternal = typeof imageMetadata === 'string' && (imageMetadata.startsWith('http') || imageMetadata.startsWith('/'));
---

{
  isLocal ? (
    <Image 
      src={imageMetadata} 
      alt={alt} 
      class:list={["block w-full h-full object-cover", className]} 
      width={400} 
      height={400} 
      format="webp"
    />
  ) : isExternal ? (
    <img 
      src={imageMetadata} 
      alt={alt} 
      class:list={["block w-full h-full object-cover", className]} 
      loading="lazy" 
    />
  ) : (
    <div class:list={["bg-neutral-100 dark:bg-neutral-900 flex items-center justify-center text-[10px] uppercase tracking-tighter text-neutral-400", className]}>
      <span>No Image</span>
    </div>
  )
}