---
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
export async function getStaticPaths() {
  const photos = await getCollection("photos");
  return photos
    .filter(p => p.data.type !== "external")
    .map((p) => ({
      params: { slug: p.slug },
      props: { photoEntry: p },
    }));
}
const { photoEntry } = Astro.props;
const { Content } = await photoEntry.render();
---
<PageLayout title={photoEntry.data.title}>
  <div class="max-w-6xl mx-auto px-6 pt-4 pb-24">
    
    <div class="mb-2 pt-6">
      <a 
        href="/photos" 
        class="group inline-flex items-center gap-2 text-sm font-sans uppercase tracking-widest text-stone-500 hover:text-black dark:text-stone-400 dark:hover:text-white transition-all duration-300"
      >
        <svg 
          xmlns="http://www.w3.org/2000/svg" 
          width="16" 
          height="16" 
          viewBox="0 0 24 24" 
          fill="none" 
          stroke="currentColor" 
          stroke-width="2.5" 
          stroke-linecap="round" 
          stroke-linejoin="round" 
          class="transition-transform duration-300 group-hover:-translate-x-1"
        >
          <path d="m15 18-6-6 6-6"/>
        </svg>
        Back to Albums
      </a>
    </div>

    <header class="mb-2 relative z-10">
      <h1 class="text-5xl md:text-4xl font-bold tracking-tighter uppercase leading-[0.85] text-stone-900 dark:text-white">
        {photoEntry.data.title}
      </h1>
      {photoEntry.data.description && (
        <p class="mt-2 text-xl font text-stone-600 dark:text-stone-400">
          {photoEntry.data.description}
        </p>
      )}
    </header>

    <div class="album-content-root">
      <div id="photo-content" class="prose dark:prose-invert max-w-none mb-12">
        <Content />
      </div>
      
      <div id="photo-grid" class="flex flex-wrap gap-1 justify-start bg-white dark:bg-stone-950 p-1">
      </div>
    </div>
  </div>
</PageLayout>

<script>
  function setupAlbum() {
    const source = document.getElementById('photo-content');
    const grid = document.getElementById('photo-grid');
    
    if (!source || !grid || grid.children.length > 0) return;

    const images = source.querySelectorAll('img');
    if (images.length === 0) return;

    // The MDX-rendered imgs have onclick="window.openLightbox('publicId', 'title')"
    // Extract the publicId from that attribute; fall back to img.src for plain imgs.
    const album = Array.from(images).map(img => {
      const onclick = img.getAttribute('onclick') || '';
      const match = onclick.match(/openLightbox\(['"]([^'"]+)['"]/);
      const publicId = match ? match[1] : img.src;
      return { publicId, title: img.alt || '' };
    });

    const albumJson = JSON.stringify(album);

    images.forEach((img, index) => {
      const container = document.createElement('div');
      container.className = 'gallery-image-container';

      img.style.display = 'block';
      img.style.width = '100%';
      img.style.height = '100%';
      img.removeAttribute('height');
      img.removeAttribute('width');

      // Strip the old 2-arg inline onclick so it doesn't fire separately
      img.removeAttribute('onclick');

      // Attach a single click handler with the full album context
      container.addEventListener('click', () => {
        (window as any).openLightbox(album[index].publicId, album[index].title, albumJson);
      });

      container.appendChild(img);
      grid.appendChild(container);
    });
    
    source.style.display = 'none';
  }

  document.addEventListener('astro:page-load', setupAlbum);
  setupAlbum();
</script>

<style is:global>
  #photo-grid {
    display: flex !important;
    flex-wrap: wrap !important;
    gap: 8px !important;
    justify-content: center !important;
    background-color: transparent !important;
  }

  #photo-grid::after {
    display: none;
  }

  .gallery-image-container {
    height: 300px !important;
    flex: 1 1 auto !important;
    overflow: hidden !important;
    background-color: white !important;
    position: relative;
    max-width: 100%;
    cursor: zoom-in;
  }

  .gallery-image-container img {
    height: 100% !important;
    width: auto !important;
    min-width: 100% !important;
    object-fit: cover !important;
    display: block !important;
    transition: transform 0.3s ease;
  }

  .gallery-image-container:hover img {
    transform: scale(1.03);
  }
</style>