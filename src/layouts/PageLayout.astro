---
import Head from "@components/Head.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import { SITE } from "@consts";
---

<!doctype html>
<html lang="en">
  <head>
    <Head title={SITE.NAME} description={SITE.DESCRIPTION} />
    <link rel="canonical" href={Astro.url} />
   
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Ken Marlow",
      "url": "https://originalarchive.com",
      "sameAs": [
       "https://instagram.com/originalarchive",
  	   "https://github.com/originalarchive",
       "https://the.fotoapp.co/originalarchive",
       "https://www.threads.net/@originalarchive",
       "https://bsky.app/profile/originalarchive.bsky.social"
      ],
      "jobTitle": "Photographer & Problem Solver",
      "description": "Ken Marlow is the creator of Original Archive, a digital journal for photography, coffee logs, reviews and random things of interest."
    }
    </script>
    
  </head>
  <body class="bg-[#f5f5f4] dark:bg-stone-900 text-stone-800 dark:text-stone-200 transition-colors duration-300 flex flex-col min-h-screen">
    <Header />
    
    <main class="grow pt-24 pb-2">
      <slot />
    </main>

    <footer class="w-full border-t border-black/5 dark:border-white/5">
      <Footer />
    </footer>

    <div 
      id="lb-overlay" 
      style="display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.98); z-index: 10000; flex-direction: column; align-items: center; justify-content: center; touch-action: none;"
    >
      <div style="position: absolute; inset: 0; z-index: -1;" onclick="window.closeLightbox()"></div>

      <button id="lb-prev" style="position: absolute; left: 20px; color: white; background: none; border: none; font-size: 3rem; cursor: pointer; z-index: 10001; padding: 20px; display: none;">‹</button>
      <button id="lb-next" style="position: absolute; right: 20px; color: white; background: none; border: none; font-size: 3rem; cursor: pointer; z-index: 10001; padding: 20px; display: none;">›</button>

      <img 
        id="lb-img" 
        src="" 
        style="max-width: 95vw; max-height: 85vh; object-fit: contain; display: block; user-select: none; -webkit-user-drag: none; box-shadow: 0 0 40px rgba(0,0,0,0.5);" 
        oncontextmenu="return false;"
      />

      <div id="lb-caption" style="margin-top: 20px; text-align: center; color: rgba(255,255,255,0.7); font-family: sans-serif; pointer-events: none;">
        <p id="lb-title" style="text-transform: uppercase; letter-spacing: 0.1em; font-size: 0.8rem; margin: 0;"></p>
        <p style="font-size: 0.7rem; margin-top: 4px; opacity: 0.5;">
          © <span id="copyright-year"></span> Ken Marlow @ original archive
        </p>
      </div>
    </div>

    <script is:inline>
      const cloudName = "dtjrlrbky";
      let currentAlbum = [];
      let currentIndex = 0;

      // Always look up DOM nodes fresh — never cache them at script-parse time.
      // This is the fix for Astro view transitions breaking the lightbox.
      function getEl(id) {
        return document.getElementById(id);
      }

      function updateLightbox() {
        const item = currentAlbum[currentIndex];
        if (!item) return;

        const isGallery = currentAlbum.length > 1;
        const prevBtn = getEl('lb-prev');
        const nextBtn = getEl('lb-next');
        if (prevBtn) prevBtn.style.display = isGallery ? 'block' : 'none';
        if (nextBtn) nextBtn.style.display = isGallery ? 'block' : 'none';

        const img = getEl('lb-img');
        if (img) {
          const src = item.publicId;
          if (src.startsWith('http') || src.startsWith('/') || src.startsWith('./')) {
            img.src = src;
          } else {
            img.src = `https://res.cloudinary.com/${cloudName}/image/upload/f_auto,q_auto,w_1600/${src}`;
          }
          img.alt = item.title || 'Photography by Ken Marlow';
        }

        const titleEl = getEl('lb-title');
        if (titleEl) titleEl.textContent = item.title || '';
      }

      window.openLightbox = function(publicId, title, albumJson) {
        currentAlbum = JSON.parse(albumJson || '[]');
        currentIndex = currentAlbum.findIndex(item => item.publicId === publicId);
        if (currentIndex === -1) {
          currentAlbum = [{ publicId, title }];
          currentIndex = 0;
        }

        updateLightbox();

        const overlay = getEl('lb-overlay');
        if (overlay) overlay.style.display = 'flex';
        document.body.style.overflow = 'hidden';
      };

      window.closeLightbox = function() {
        const overlay = getEl('lb-overlay');
        if (overlay) overlay.style.display = 'none';
        document.body.style.overflow = 'auto';
      };

      function nextImg(e) {
        if (e) e.stopPropagation();
        currentIndex = (currentIndex + 1) % currentAlbum.length;
        updateLightbox();
      }

      function prevImg(e) {
        if (e) e.stopPropagation();
        currentIndex = (currentIndex - 1 + currentAlbum.length) % currentAlbum.length;
        updateLightbox();
      }

      // Re-bind arrow buttons and keyboard on every page load
      // (covers both hard refresh AND Astro client-side navigation)
      function bindLightboxControls() {
        const nextBtn = getEl('lb-next');
        const prevBtn = getEl('lb-prev');
        if (nextBtn) nextBtn.onclick = nextImg;
        if (prevBtn) prevBtn.onclick = prevImg;

        const yearEl = getEl('copyright-year');
        if (yearEl) yearEl.textContent = new Date().getFullYear();
      }

      // Runs on hard refresh
      bindLightboxControls();

      // Runs on every Astro client-side navigation
      document.addEventListener('astro:page-load', bindLightboxControls);

      // Keyboard navigation — also re-bound safely
      document.addEventListener('keydown', (e) => {
        const overlay = getEl('lb-overlay');
        if (!overlay || overlay.style.display !== 'flex') return;
        if (e.key === 'ArrowRight') nextImg();
        if (e.key === 'ArrowLeft') prevImg();
        if (e.key === 'Escape') window.closeLightbox();
      });

      // Block right-click on lightbox image
      document.addEventListener('contextmenu', (e) => {
        if (e.target && e.target.id === 'lb-img') e.preventDefault();
      });
    </script>
  </body>
</html>